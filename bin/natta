#!/bin/sh
# Resolve the checkout from this executable, independent of shell configuration.
# Follow symlinks (for example ~/.local/bin/natta -> <checkout>/bin/natta) with
# plain readlink, so no platform-specific realpath/readlink -f is required.
NATTA_SELF=$0
NATTA_HOPS=0
while [ -L "$NATTA_SELF" ]; do
    NATTA_HOPS=$((NATTA_HOPS + 1))
    if [ "$NATTA_HOPS" -gt 40 ]; then
        echo "natta: launcher symlink chain too long: $0" >&2
        exit 1
    fi
    NATTA_TARGET=$(readlink -- "$NATTA_SELF") || exit 1
    case $NATTA_TARGET in
        /*) NATTA_SELF=$NATTA_TARGET ;;
        *) NATTA_SELF=$(dirname -- "$NATTA_SELF")/$NATTA_TARGET ;;
    esac
done
NATTA_BIN_DIR=$(CDPATH= cd -- "$(dirname -- "$NATTA_SELF")" && pwd -P) || exit 1
NATTA_SOURCE=$NATTA_BIN_DIR/../tools/natta/natta.py
if [ ! -f "$NATTA_SOURCE" ]; then
    echo "natta: cannot find the toolkit checkout from launcher $0 (expected $NATTA_SOURCE)" >&2
    exit 1
fi
# NATTA_PYTHON selects the interpreter (default: python3 on PATH). Check the
# documented minimum first so an old interpreter fails with a message rather
# than a traceback.
NATTA_PYTHON=${NATTA_PYTHON:-python3}
if ! command -v "$NATTA_PYTHON" >/dev/null 2>&1; then
    echo "natta: Python 3.11+ is required; '$NATTA_PYTHON' was not found (set NATTA_PYTHON to a Python 3.11+ interpreter)" >&2
    exit 1
fi
if ! NATTA_PYTHON_VERSION=$("$NATTA_PYTHON" -I -c 'import sys; print("%d.%d" % sys.version_info[:2]); sys.exit(sys.version_info < (3, 11))' 2>/dev/null); then
    echo "natta: Python 3.11+ is required; found ${NATTA_PYTHON_VERSION:-an unknown version} at $(command -v "$NATTA_PYTHON") (set NATTA_PYTHON to a Python 3.11+ interpreter)" >&2
    exit 1
fi
exec "$NATTA_PYTHON" -B "$NATTA_SOURCE" "$@"
